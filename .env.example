# =====================================================
# Agent Personnel de Recherche de Stage — .env.example
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS versionner le fichier .env réel
# =====================================================

# --- Base de données ---
DATABASE_URL=postgresql://agent_user:agent_password@postgres:5432/agent_db
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password
POSTGRES_DB=agent_db

# Base de données de test (isolée — créée automatiquement par pytest)
# La base agent_db_test est séparée de agent_db pour ne jamais polluer les données prod/seed
DATABASE_URL_TEST=postgresql://agent_user:agent_password@postgres:5432/agent_db_test

# --- Sécurité API ---
# Clé API statique pour l'authentification (usage local V1)
APP_API_KEY=dev-api-key-changeme

# --- France Travail API (Sprint 2 — ingestion) ---
# Créer une application sur https://francetravail.io pour obtenir les credentials
# Laisser vide pour désactiver le connecteur France Travail
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- LLM — Ollama local (Sprint 5+) ---
# Ollama doit tourner localement : docker run -p 11434:11434 ollama/ollama
# puis : ollama pull gemma3n:e2b && ollama pull qwen2.5:7b-instruct
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_DEFAULT=gemma3n:e2b
LLM_MODEL_HQ=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=120

# --- Stockage fichiers ---
FILE_STORAGE_PATH=/data/files

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# La clé API est côté serveur uniquement (jamais exposée au navigateur)
INTERNAL_API_KEY=dev-api-key-changeme
